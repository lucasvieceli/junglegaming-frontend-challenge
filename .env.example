# Base das chamadas REST (mesma origem; o MSW intercepta)
VITE_API_URL=/api
# Host fictício do Socket.IO; o MSW intercepta a conexão antes da rede
VITE_SOCKET_URL=wss://realtime.kurio.local
# true em dev, preview, deploy de demonstração e testes
VITE_ENABLE_MOCKS=true
# Cenário inicial quando não há ?scenario= nem valor salvo
VITE_DEFAULT_SCENARIO=default
# URL pública (meta tags/canonical)
VITE_APP_URL=http://localhost:4173
