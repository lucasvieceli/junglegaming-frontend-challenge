{
  "name": "kurio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings=0 && node scripts/check-typography.mjs && node scripts/check-feature-imports.mjs",
    "format": "prettier --write .",
    "msw:init": "msw init public/ --save",
    "icons:generate": "node scripts/generate-icons.mjs && prettier --write src/shared/components/icons",
    "images:optimize": "node scripts/optimize-images.mjs",
    "test:e2e": "playwright install chromium && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update-snapshots": "playwright test specs/visual.spec.ts --update-snapshots",
    "test:e2e:report": "playwright show-report reports/playwright",
    "lighthouse:mobile": "lhci autorun --config=lighthouserc.mobile.json",
    "lighthouse:desktop": "lhci autorun --config=lighthouserc.desktop.json",
    "lighthouse": "npm run build && node scripts/lighthouse-run.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/roboto-mono": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@mswjs/socket.io-binding": "0.2.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "axios": "^1.20.0",
    "big.js": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "msw": "~2.15.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.90.0",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.104.2",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.46",
    "@types/big.js": "^7.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "shadcn": "^4.21.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
